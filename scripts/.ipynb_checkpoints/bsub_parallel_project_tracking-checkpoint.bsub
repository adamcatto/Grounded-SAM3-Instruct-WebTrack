#!/bin/bash

#BSUB -J tracking
#BSUB -P acc_KennyComputational
#BSUB -q gpu
#BSUB -n 32
#BSUB -R "rusage[mem=16000]"
#BSUB -R "span[hosts=1]"
#BSUB -R "h100nvl"
#BSUB -gpu "num=1"
#BSUB -W 144:00
#BSUB -oo /sc/arion/projects/KennyComputational/Behavior/logs/%J.out
#BSUB -eo /sc/arion/projects/KennyComputational/Behavior/logs/%J.err

set -euo pipefail

if [[ -z "${PROJECT_DIR:-}" ]]; then
    echo
    echo "ERROR: PROJECT_DIR environment variable is not set."
    echo
    echo "Set it before submitting the job, for example:"
    echo
    echo "  export PROJECT_DIR=/path/to/project"
    echo "  bsub < bsub_parallel_project_tracking.bsub"
    echo
    echo "Or in one line:"
    echo
    echo "  PROJECT_DIR=/path/to/project bsub < bsub_parallel_project_tracking.bsub"
    echo
    exit 1
fi

echo "PROJECT_DIR=${PROJECT_DIR}"
echo "EXTRA_ARGS=$*"

REPO_ROOT="/sc/arion/projects/KennyComputational/Behavior/Grounded-SAM3-Instruct-WebTrack"

cd "${REPO_ROOT}"

source /sc/arion/work/cattoa01/miniconda3/etc/profile.d/conda.sh
conda activate /sc/arion/work/cattoa01/miniconda3/envs/sam3

python scripts/parallel_tracking_worker.py \
    --use-all-anchors \
    --clear-stuck \
    "${PROJECT_DIR}" \
    "$@"