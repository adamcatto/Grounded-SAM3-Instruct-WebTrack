#!/bin/bash
# ===========================================================================
# Behavior quantification (clustering) pipeline — LSF job
#
# Runs the downstream clustering / behavior-quantification step end to end:
# sliding-window sequence features -> normalization + optional ComBat batch
# correction -> Leiden clustering -> UMAP -> condition comparisons -> plots +
# Excel. This is the single-process stage that follows per-video frame-feature
# extraction.
#
# For LARGE projects, extract frame features in parallel FIRST (they are cached
# and reused here):
#   python downstream_analysis/clustering/generate_bsub_jobs.py \
#       --project-dir "$PROJECT_DIR" --submit-all
# then submit this job once all features are cached. If features are missing,
# this job still runs but extracts them inline on this single node (slower).
#
# Usage:
#   export PROJECT_DIR=/path/to/project
#   bsub < scripts/bsub_behavior_quantification.bsub                 # pair-level
#   PROJECT_DIR=... bsub < scripts/bsub_behavior_quantification.bsub -- --single-animal
#
# Anything after `--` (or any extra args) is forwarded to the clustering CLI,
# e.g. --single-animal, --resolution 0.5, --window-size 150 --stride 50,
# --output-dir /merged/out, --skip-mask-verification.
# ===========================================================================

#BSUB -J behav_quant
#BSUB -P acc_KennyComputational
#BSUB -q premium
#BSUB -n 32
#BSUB -R "rusage[mem=16000]"
#BSUB -R "span[hosts=1]"
#BSUB -W 12:00
#BSUB -oo /sc/arion/projects/KennyComputational/Behavior/logs/%J.out
#BSUB -eo /sc/arion/projects/KennyComputational/Behavior/logs/%J.err

set -euo pipefail

if [[ -z "${PROJECT_DIR:-}" ]]; then
    echo "ERROR: PROJECT_DIR environment variable is not set." >&2
    echo "  export PROJECT_DIR=/path/to/project" >&2
    echo "  bsub < scripts/bsub_behavior_quantification.bsub -- [extra clustering args]" >&2
    exit 1
fi

# Drop a leading `--` separator if present so extra args pass through cleanly.
EXTRA_ARGS=("$@")
if [[ "${#EXTRA_ARGS[@]}" -gt 0 && "${EXTRA_ARGS[0]}" == "--" ]]; then
    EXTRA_ARGS=("${EXTRA_ARGS[@]:1}")
fi

echo "PROJECT_DIR=${PROJECT_DIR}"
echo "EXTRA_ARGS=${EXTRA_ARGS[*]:-（none）}"
echo "Host: $(hostname)  Date: $(date)"

REPO_ROOT="/sc/arion/projects/KennyComputational/Behavior/Grounded-SAM3-Instruct-WebTrack"
cd "${REPO_ROOT}"

ml purge 2>/dev/null || true
set +u
source /sc/arion/work/cattoa01/miniconda3/etc/profile.d/conda.sh
conda activate /sc/arion/work/cattoa01/miniconda3/envs/sam3
set -u
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"

echo "========================================="
echo "Running behavior quantification pipeline …"
echo "========================================="

# --skip-mask-verification is safe here: tracking already validated masks.
python -m downstream_analysis.clustering \
    --project-dir "${PROJECT_DIR}" \
    --skip-mask-verification \
    "${EXTRA_ARGS[@]}"

echo "========================================="
echo "Behavior quantification complete: $(date)"
echo "Outputs under: ${PROJECT_DIR}/analysis_of_tracking_data/clustering/"
echo "Next: generate a focused report + slides (see behavior-quant-reporting skill)."
echo "========================================="
