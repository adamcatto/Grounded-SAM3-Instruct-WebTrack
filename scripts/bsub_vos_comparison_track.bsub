#!/bin/bash

#BSUB -J vos_track
#BSUB -P acc_KennyComputational
#BSUB -q gpu
#BSUB -n 32
#BSUB -R "rusage[mem=16000]"
#BSUB -R "span[hosts=1]"
#BSUB -R "h100nvl"
#BSUB -gpu "num=1"
#BSUB -W 144:00
#BSUB -oo /sc/arion/projects/KennyComputational/Behavior/logs/%J_%I.out
#BSUB -eo /sc/arion/projects/KennyComputational/Behavior/logs/%J_%I.err

# ─────────────────────────────────────────────────────────────────────────────
# One tracking worker for the vos_comparison single-shot project. Submitted by
# scripts/bsub_vos_comparison.sh as a job ARRAY ("name[1-N]"): every element runs
# this same script and claims distinct videos via the flock'd
# `tracked_videos_in_progress.txt` claims file, so N elements = N parallel workers.
#
# Required env: PROJECT_DIR  (the single_shot_vos_* project directory)
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

if [[ -z "${PROJECT_DIR:-}" ]]; then
    echo "ERROR: PROJECT_DIR is not set (the single-shot project dir)." >&2
    exit 1
fi

echo "PROJECT_DIR=${PROJECT_DIR}"
echo "EXTRA_ARGS=$*"

REPO_ROOT="/sc/arion/projects/KennyComputational/Behavior/Grounded-SAM3-Instruct-WebTrack"

# Derive a per-worker backend port so workers never collide, even if LSF
# co-locates two on one node. Array elements share LSB_JOBID but differ in
# LSB_JOBINDEX; standalone jobs differ in LSB_JOBID — combine both so either works.
BACKEND_PORT=$(( 8800 + ((${LSB_JOBID:-$$} + ${LSB_JOBINDEX:-0}) % 150) ))

cd "${REPO_ROOT}"

source /sc/arion/work/cattoa01/miniconda3/etc/profile.d/conda.sh
conda activate /sc/arion/work/cattoa01/miniconda3/envs/sam3
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export SAM3_PROJECTS_DIR="$(dirname "${PROJECT_DIR}")"
export CUDA_VISIBLE_DEVICES=0
export no_proxy="127.0.0.1,localhost,${no_proxy:-}"

# ── Kill any stale process on the chosen port ──────────────────────────────
fuser -k "${BACKEND_PORT}/tcp" >/dev/null 2>&1 || true
sleep 0.3

# ── Start backend inline ───────────────────────────────────────────────────
echo "Starting uvicorn on port ${BACKEND_PORT} …"
cd backend
python -m uvicorn server:app --host 127.0.0.1 --port "${BACKEND_PORT}" --log-level info &
UVICORN_PID=$!
cd "${REPO_ROOT}"

cleanup() { kill "$UVICORN_PID" 2>/dev/null || true; wait "$UVICORN_PID" 2>/dev/null || true; }
trap cleanup EXIT

# ── Wait for backend health (up to 20 min for cold NFS imports) ────────────
HEALTH_URL="http://127.0.0.1:${BACKEND_PORT}/api/health"
echo "Waiting for backend health at ${HEALTH_URL} …"
WAITED=0; MAX_WAIT=1200
while true; do
    if ! kill -0 "$UVICORN_PID" 2>/dev/null; then
        echo "ERROR: uvicorn (PID $UVICORN_PID) exited before becoming healthy" >&2
        exit 1
    fi
    HTTP_CODE=$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' --max-time 5 "$HEALTH_URL" 2>/dev/null || echo "000")
    [[ "$HTTP_CODE" == "200" ]] && { echo "Backend healthy after ${WAITED}s"; break; }
    if (( WAITED >= MAX_WAIT )); then
        echo "ERROR: backend health timed out after ${MAX_WAIT}s (last HTTP ${HTTP_CODE})" >&2
        exit 1
    fi
    (( WAITED % 60 == 0 && WAITED > 0 )) && echo "  still waiting … ${WAITED}s, HTTP ${HTTP_CODE}"
    sleep 5; WAITED=$((WAITED + 5))
done

# ── Claim + propagate videos (shared claims file coordinates the jobs) ─────
python scripts/parallel_tracking_worker.py \
    --local-gpu-workers 0 \
    --backend "http://127.0.0.1:${BACKEND_PORT}" \
    --clear-stuck \
    "${PROJECT_DIR}" \
    "$@"
