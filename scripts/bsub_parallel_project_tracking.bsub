#!/bin/bash

#BSUB -J tracking
#BSUB -P acc_KennyComputational
#BSUB -q gpu
#BSUB -n 32
#BSUB -R "rusage[mem=16000]"
#BSUB -R "span[hosts=1]"
#BSUB -R "h100nvl"
#BSUB -gpu "num=1"
#BSUB -W 144:00
#BSUB -oo /sc/arion/projects/KennyComputational/Behavior/logs/%J.out
#BSUB -eo /sc/arion/projects/KennyComputational/Behavior/logs/%J.err

set -euo pipefail

if [[ -z "${PROJECT_DIR:-}" ]]; then
    echo
    echo "ERROR: PROJECT_DIR environment variable is not set."
    echo
    echo "Set it before submitting the job, for example:"
    echo
    echo "  export PROJECT_DIR=/path/to/project"
    echo "  bsub < bsub_parallel_project_tracking.bsub"
    echo
    echo "Or in one line:"
    echo
    echo "  PROJECT_DIR=/path/to/project bsub < bsub_parallel_project_tracking.bsub"
    echo
    exit 1
fi

echo "PROJECT_DIR=${PROJECT_DIR}"
echo "EXTRA_ARGS=$*"

REPO_ROOT="/sc/arion/projects/KennyComputational/Behavior/Grounded-SAM3-Instruct-WebTrack"

cd "${REPO_ROOT}"

source /sc/arion/work/cattoa01/miniconda3/etc/profile.d/conda.sh
conda activate /sc/arion/work/cattoa01/miniconda3/envs/sam3
export LD_LIBRARY_PATH="$CONDA_PREFIX/lib:${LD_LIBRARY_PATH:-}"
export SAM3_PROJECTS_DIR="$(dirname "${PROJECT_DIR}")"
export CUDA_VISIBLE_DEVICES=0
# Ensure localhost/127.0.0.1 bypasses the HPC HTTP proxy (which returns 503 for local backends)
export no_proxy="127.0.0.1,localhost,${no_proxy:-}"

# ── Pick a free backend port ───────────────────────────────────────────────
# Multiple tracking jobs can land on the SAME host (span[hosts=1] + -gpu num=1
# does not reserve the whole node). A fixed port would collide — and the
# fuser -k below would kill a co-located job's backend. Bind to an OS-assigned
# free port instead so co-located jobs stay isolated.
BACKEND_PORT="$(python -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
echo "Selected backend port ${BACKEND_PORT} on host $(hostname)"

# ── Kill any stale process on the target port ──────────────────────────────
fuser -k "${BACKEND_PORT}/tcp" >/dev/null 2>&1 || true
sleep 0.3

# ── Start backend inline (same approach as start_backend.sh) ───────────────
echo "Starting uvicorn on port ${BACKEND_PORT} …"
cd backend
python -m uvicorn server:app \
    --host 127.0.0.1 \
    --port "${BACKEND_PORT}" \
    --log-level info &
UVICORN_PID=$!
cd "${REPO_ROOT}"

cleanup() { kill "$UVICORN_PID" 2>/dev/null || true; wait "$UVICORN_PID" 2>/dev/null || true; }
trap cleanup EXIT

# ── Wait for backend health (up to 20 minutes for cold NFS imports) ────────
HEALTH_URL="http://127.0.0.1:${BACKEND_PORT}/api/health"
echo "Waiting for backend health at ${HEALTH_URL} …"
WAITED=0
MAX_WAIT=1200
while true; do
    if ! kill -0 "$UVICORN_PID" 2>/dev/null; then
        echo "ERROR: uvicorn (PID $UVICORN_PID) exited before becoming healthy"
        exit 1
    fi
    HTTP_CODE=$(curl --noproxy '*' -s -o /dev/null -w '%{http_code}' --max-time 5 "$HEALTH_URL" 2>/dev/null || echo "000")
    if [[ "$HTTP_CODE" == "200" ]]; then
        echo "Backend healthy after ${WAITED}s"
        break
    fi
    if (( WAITED >= MAX_WAIT )); then
        echo "ERROR: backend health check timed out after ${MAX_WAIT}s (last HTTP ${HTTP_CODE})"
        exit 1
    fi
    if (( WAITED % 60 == 0 && WAITED > 0 )); then
        echo "  still waiting … ${WAITED}s elapsed, HTTP ${HTTP_CODE}"
    fi
    sleep 5
    WAITED=$((WAITED + 5))
done

# ── Run tracking worker (backend already running, single-process mode) ─────
python scripts/parallel_tracking_worker.py \
    --local-gpu-workers 0 \
    --backend "http://127.0.0.1:${BACKEND_PORT}" \
    --use-all-anchors \
    --clear-stuck \
    "${PROJECT_DIR}" \
    "$@"
