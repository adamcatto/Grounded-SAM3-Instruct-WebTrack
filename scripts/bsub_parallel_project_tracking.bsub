#!/bin/bash

#BSUB -J tracking
#BSUB -P acc_KennyComputational
#BSUB -q gpu
#BSUB -n 32
#BSUB -R "rusage[mem=16000]"
#BSUB -R "span[hosts=1]"
#BSUB -R "h100nvl"
#BSUB -gpu "num=1"
#BSUB -W 144:00
#BSUB -oo /sc/arion/projects/KennyComputational/Behavior/logs/%J.out
#BSUB -eo /sc/arion/projects/KennyComputational/Behavior/logs/%J.err

set -euo pipefail

echo "PROJECT_DIR=${PROJECT_DIR}"
echo "EXTRA_ARGS=${EXTRA_ARGS:-}"

REPO_ROOT="/sc/arion/projects/KennyComputational/Behavior/Grounded-SAM3-Instruct-WebTrack"

cd "${REPO_ROOT}"

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sam3

/sc/arion/work/cattoa01/miniconda3/envs/sam3/bin/python \
    scripts/parallel_tracking_worker.py \
    --retry-failed \
    --clear-stuck \
    "${PROJECT_DIR}" \
    ${EXTRA_ARGS:-}