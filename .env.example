# Copy this file to .env and set the directory that contains your projects.
SAM3_PROJECTS_DIR=/path/to/projects/folder

# Chat agent LLM. start_backend.sh launches vLLM on :8001 with this profile
# unless AGENT_LLM_AUTOSTART=0 (log: logs/vllm_agent.log).
#   a100-shared  Qwen3-VL-8B, shares one 80GB GPU with SAM3 (default)
#   a100         Qwen3-VL-32B, needs a dedicated 80GB GPU
#   h100x4       Qwen2.5-VL-72B, tensor-parallel over 4 GPUs
# AGENT_LLM_PROFILE=a100-shared
# AGENT_LLM_AUTOSTART=1
