#!/usr/bin/env python3
"""
Git prepare-commit-msg: strip Cursor IDE attribution trailers from the commit
message file when they appear at the end (so local git UI / agents cannot leave
them in without the user noticing).
"""
from __future__ import annotations

import re
import sys
from pathlib import Path


def strip_cursor_trailers(text: str) -> str:
    lines = text.splitlines(keepends=True)
    while lines:
        last = lines[-1].strip()
        if last == "":
            lines.pop()
            continue
        if re.fullmatch(r"Made-with:\s*Cursor\s*", last, re.I):
            lines.pop()
            continue
        if re.fullmatch(r"Made\s+with\s+Cursor\s*", last, re.I):
            lines.pop()
            continue
        if re.fullmatch(r"Co-authored-by:\s*Cursor\s*<[^>]+>\s*", last, re.I):
            lines.pop()
            continue
        break
    while lines and lines[-1].strip() == "":
        lines.pop()
    out = "".join(lines)
    if out and not out.endswith("\n"):
        out += "\n"
    return out


def main() -> int:
    if len(sys.argv) < 2:
        return 0
    path = Path(sys.argv[1])
    if not path.is_file():
        return 0
    try:
        before = path.read_text(encoding="utf-8")
    except OSError:
        return 0
    after = strip_cursor_trailers(before)
    if after != before:
        path.write_text(after, encoding="utf-8")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
